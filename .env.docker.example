# ==========================================
# VARIABLES DE ENTORNO PARA DOCKER
# ==========================================

# 1. Base de datos PostgreSQL interna en Docker
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=ergocheck_db
DB_PORT=5432

# URL de conexión interna entre contenedores Docker:
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/ergocheck_db?schema=public

# Si prefieres usar una base de datos externa (ej. AWS RDS o Supabase), descomenta y coloca tu URL:
# DATABASE_URL=postgresql://usuario:clave@tu-rds.amazonaws.com:5432/postgres?schema=public

# 2. Seguridad y JWT
JWT_SECRET=ergocheck-ai-secure-jwt-secret-key-2026-uagrm
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=production
