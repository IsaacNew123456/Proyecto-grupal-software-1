# ==========================================
# VARIABLES DE ENTORNO PARA DOCKER & PRODUCCIÓN (AWS)
# ==========================================

# 1. Base de datos PostgreSQL en Supabase
DATABASE_URL="postgresql://postgres:[TU_CLAVE]@db.[TU_PROYECTO].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[TU_CLAVE]@db.[TU_PROYECTO].supabase.co:5432/postgres"

# 2. Seguridad y Autenticación JWT
JWT_SECRET=ergocheck-ai-secure-jwt-secret-key-2026-uagrm
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=production

# 3. (Opcional) Si decides usar PostgreSQL interno en Docker en vez de Supabase:
# DB_USER=postgres
# DB_PASSWORD=postgrespassword
# DB_NAME=ergocheck_db
# DB_PORT=5432
