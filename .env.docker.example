# ==========================================
# VARIABLES DE ENTORNO PARA DOCKER & PRODUCCIÓN (AWS)
# ==========================================

# 1. Base de datos PostgreSQL interna en Docker (Predeterminado)
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=ergocheck_db
DB_PORT=5432

DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/ergocheck_db?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@postgres:5432/ergocheck_db?schema=public"

# 2. Seguridad y Autenticación JWT
JWT_SECRET=ergocheck-ai-secure-jwt-secret-key-2026-uagrm
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=production
